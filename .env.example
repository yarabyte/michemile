APP_ENV=production
APP_DEBUG=false
APP_URL=https://michemil.com
APP_KEY=change-me-to-a-long-random-string-64chars-min
APP_LOCALE=fr
APP_NAME="Les Résidences hôtelières Micheline & Emile"

# Chemin admin non devinable (sans slash initial ni final)
ADMIN_PATH=gestion-i4i-bMmd5KAS92UU

DB_HOST=127.0.0.1
# Sur OVH mutualisé, utiliser souvent "localhost" (socket). En local macOS: 127.0.0.1
DB_PORT=3306
DB_NAME=michemil
DB_USER=michemil
DB_PASS=

MAIL_FROM=noreply@michemil.com
MAIL_FROM_NAME="Micheline & Emile"
MAIL_BOOKING=booking@michemil.com
# smtp|mail
MAIL_DRIVER=mail
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=tls

SESSION_NAME=MICHEMILSESSID
SESSION_SECURE=true
SESSION_LIFETIME=7200

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# reCAPTCHA v3 (laisser vide pour utiliser le honeypot seul)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# HSTS (activer seulement en HTTPS)
HSTS_ENABLED=true
