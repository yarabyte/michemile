{
  "name": "michemil/site",
  "description": "Les Résidences hôtelières Micheline & Emile — site PHP 8.2 sécurisé",
  "type": "project",
  "require": {
    "php": "^8.2",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-mbstring": "*",
    "ext-json": "*",
    "ext-fileinfo": "*",
    "ext-gd": "*",
    "ext-openssl": "*",
    "ezyang/htmlpurifier": "^4.18",
    "robthree/twofactorauth": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
